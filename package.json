{
    "name": "page-transition",
    "version": "0.1.0-beta.61",
    "description": "A page transition library for the Next.js App Router.",
    "license": "MIT",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./css": {
            "types": "./dist/css.d.ts",
            "default": "./dist/css.js"
        },
        "./manual": {
            "types": "./dist/manual.d.ts",
            "default": "./dist/manual.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc"
    },
    "peerDependencies": {
        "next": "^15.0.0 || ^16.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "typescript": "^5.9.3"
    }
}
